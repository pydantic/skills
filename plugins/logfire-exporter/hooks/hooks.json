{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/run_codex_logfire_hook.sh\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\scripts\\run_codex_logfire_hook.cmd\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/run_codex_logfire_hook.sh\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\scripts\\run_codex_logfire_hook.cmd\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
